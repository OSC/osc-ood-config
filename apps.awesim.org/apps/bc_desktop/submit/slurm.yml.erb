<%- 
-%>
---
batch_connect:
  before_script: |
    # Export the module function if it exists
    [[ $(type -t module) == "function"  ]] && export -f module

    # MATE acts strange in pitzer-exp and doesn't like /var/run/$(id -u)
    export XDG_RUNTIME_DIR="$TMPDIR/xdg_runtime"

    # reset SLURM_EXPORT_ENV so that things like srun & sbatch work out of the box
    export SLURM_EXPORT_ENV=ALL
script:
  native:
  <%- if global_gpus.to_i > 0 -%>
  gpus_per_node: <%= global_gpus %>
  <%- end %>
  native:
  # set nodes
  - "--nodes"
  - "<%= bc_num_nodes.to_i %>"
  # set cpus per node
  - "--ntasks-per-node"
  - "<%= global_num_cores.to_i %>"
  # set partition
  - "--partition"
  <%- if global_enable_debug.to_i == 1 -%>
  - "debug"
  <%- elsif global_gpus.to_i > 0 -%>
  - "<%= global_gpu_type.split('-').drop(1).join('-') %>"
  <%- else %>
  - "batch"
  <%- end %>
  # set memory
  <%- if global_enable_mem.to_i == 1  -%>
  - "--mem"
  - "<%= global_mem.to_i%>G"
  <%- end %>
  # set visualization
  <%- if global_enable_vis.to_i == 1 -%>
  - "--gres"
  - "vis"
  <%- end %>
  # set license
  <%- if !global_licenses.empty? %>
  - "--licenses"
  - "<%= global_licenses %>"
  <%- end %>
